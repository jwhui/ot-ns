#
# Format or check OTNS v3 C/C++ source files using OpenThread's .clang-format rules.
#
# Usage:
#   ./script/make-pretty               # Format all C/C++ sources in place
#   ./script/make-pretty clang-format  # Same as above
#   ./script/make-pretty check         # Verify formatting without modifying files
#

set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
readonly repo_dir

OTNS_EXCLUDE_REGEX='^(third_party|openthread|build[^/]*|web/node_modules)/'
readonly OTNS_EXCLUDE_REGEX

find_clang_format()
{
    if [[ -n ${CLANG_FORMAT:-} ]]; then
        echo "${CLANG_FORMAT}"
    elif command -v clang-format-19 >/dev/null 2>&1; then
        echo "clang-format-19"
    elif command -v clang-format >/dev/null 2>&1; then
        echo "clang-format"
    else
        echo >&2 "ERROR: clang-format (v19 recommended) not found in PATH."
        exit 1
    fi
}

list_cxx_files()
{
    git -C "${repo_dir}" ls-files --cached --others --exclude-standard \
        -- '*.c' '*.cc' '*.cpp' '*.h' '*.hpp' \
        | grep -v -E "${OTNS_EXCLUDE_REGEX}" || true
}

do_clang_format()
{
    local cf
    cf=$(find_clang_format)
    echo "Formatting C/C++ files with ${cf} ($("${cf}" --version))"

    local files
    files=$(list_cxx_files)
    if [[ -z ${files} ]]; then
        echo "No C/C++ files found."
        return 0
    fi

    (cd "${repo_dir}" && printf '%s\n' "${files}" | xargs "${cf}" -style=file -i)
}

do_clang_format_check()
{
    local cf
    cf=$(find_clang_format)
    echo "Checking C/C++ formatting with ${cf} ($("${cf}" --version))"

    local files
    files=$(list_cxx_files)
    if [[ -z ${files} ]]; then
        echo "No C/C++ files found."
        return 0
    fi

    (cd "${repo_dir}" && printf '%s\n' "${files}" | xargs "${cf}" -style=file --dry-run --Werror)
    echo "All C/C++ files match OpenThread formatting."
}

main()
{
    if [[ $# -eq 0 ]]; then
        do_clang_format
    elif [[ $1 == 'clang' || $1 == 'clang-format' ]]; then
        do_clang_format
    elif [[ $1 == 'check' ]]; then
        shift
        if [[ $# -eq 0 || $1 == 'clang' || $1 == 'clang-format' ]]; then
            do_clang_format_check
        else
            echo >&2 "Unsupported check: $1. Supported: clang, clang-format"
            exit 128
        fi
    else
        echo >&2 "Unsupported action: $1. Supported: clang, clang-format, check"
        exit 128
    fi
}

main "$@"

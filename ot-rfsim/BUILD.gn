# GN build definition for integrating ot-rfsim v3 into project-chip/connectedhomeip
# (via third_party/openthread/platforms/otns/BUILD.gn).

import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")
import("//build_overrides/openthread.gni")
import("${chip_root}/src/platform/device.gni")

config("rfsim_v3_public_config") {
  include_dirs = [ "include" ]
}

static_library("otns") {
  # Matter owns process-wide signal handlers and syslog; run ot-rfsim v3 in library mode.
  defines = [ "OPENTHREAD_RFSIM_CONFIG_LIBRARY_MODE_ENABLE=1" ]

  include_dirs = [
    "src",
    "../src",
    "${openthread_root}/examples/platforms",
    "${openthread_root}/examples/platforms/utils",
  ]

  public = [
    "${openthread_root}/examples/platforms/openthread-select.h",
    "${openthread_root}/examples/platforms/openthread-system.h",
    "include/ot_rfsim_v3.h",
  ]

  sources = [
    "${openthread_root}/src/lib/platform/exit_code.c",
    "${openthread_root}/src/lib/platform/exit_code.h",
    "../src/protocol/rfsim_v3_codec.cpp",
    "../src/protocol/rfsim_v3_codec.hpp",
    "src/rfsim_client.cpp",
    "src/rfsim_client.hpp",
  ]

  # ConnectedHomeIP links OpenThread's cli_uart so OTNS can issue OpenThread CLI
  # commands to Matter nodes over ot-rfsim v3 kCliData via otPlatUart*.
  deps = [
    "${chip_root}/third_party/openthread:openthread_cli",
    "${chip_root}/third_party/openthread/platforms:libopenthread-platform-utils",
    "${openthread_root}/examples/apps/cli:cli_uart",
    "${openthread_root}/src/core:libopenthread_core_headers",
  ]

  if (chip_openthread_ftd) {
    configs += [ "${openthread_root}:openthread_ftd_config" ]
  } else {
    configs += [ "${openthread_root}:openthread_mtd_config" ]
  }

  public_configs = [
    ":rfsim_v3_public_config",
    "${chip_root}/third_party/openthread/platforms:libopenthread-platform_config",
  ]
}
